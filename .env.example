# Copie este arquivo para .env e ajuste o que precisar.

# Porta do sistema
PORT=3000

# E-mail de quem será o dono do sistema (perfil Gestão). Só este e-mail consegue fazer o primeiro acesso.
# Deixe preenchido antes de colocar o endereço na internet.
OWNER_EMAIL=

# Coloque 1 se o sistema estiver atrás de um proxy (Railway, Render, Caddy, Nginx, Cloudflare Tunnel).
# Deixe vazio se as pessoas acessam direto pelo IP:3000.
TRUST_PROXY=

# true = qualquer pessoa com o endereço pode criar conta e aguardar a gestão liberar o perfil
# false = só a gestão cria contas, pela aba Equipe e permissões
ALLOW_SIGNUP=true

# Opcional: chave da API da Anthropic para ligar a IA (textos de campanha, análise do NPS
# e classificação automática dos leads que chegam pelo WhatsApp). Crie em https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
