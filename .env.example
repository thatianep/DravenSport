# Copie este arquivo para .env e ajuste o que precisar.

# Porta do sistema
PORT=3000

# false = só a gestão consegue colocar gente nova (depois que todos tiverem conta)
ALLOW_SIGNUP=true

# Opcional: chave da API da Anthropic para ligar a IA (textos de campanha, análise do NPS
# e classificação automática dos leads que chegam pelo WhatsApp). Crie em https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
